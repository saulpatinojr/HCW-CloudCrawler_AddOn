# Base image for every FROM in infrastructure/docker/Dockerfile (CONTRACT-DECISIONS item 20): the website's current pin,
# the Docker Official Image python:3.14.8-slim-trixie (CPython 3.14.8 on Debian 13), by index digest. The tag beside
# the digest is documentation; Docker resolves the digest. ci.yml fails when any FROM that is not an earlier stage
# differs from BASE_IMAGE@BASE_DIGEST, so the two cannot drift. Plain shell assignments, read by /bin/sh.
# Moved to 3.14.8 on 2026-10-16 with the website; the digest was read with
# `docker buildx imagetools inspect python:3.14.8-slim-trixie` and equals the website's. Dependabot does not bump this
# base, because it follows the website's pin: .github/dependabot.yml has no docker entry.
BASE_IMAGE=python:3.14.8-slim-trixie
BASE_DIGEST=sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170
BASE_PYTHON_VERSION=3.14.8
