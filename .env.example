# Cloud Crawler lab edition: every environment variable, no secret values.
# Copy to .env for local development; the lab host renders these from the website repository's
# Ansible role (public values in group_vars, secrets in the host vault as vault_addon_cloud_crawler_<name>).

# Listening port inside the container (the lab host publishes a loopback port -> 8080).
PORT=8080

# Exact origins allowed by CORS, space-separated. Empty in production: the pane is same-origin with its API.
CC_ALLOWED_ORIGINS=

# Content-Security-Policy frame-ancestors. Default 'none' (also sends X-Frame-Options: DENY).
# The lab host sets the two site origins; the value must equal the host's caddy_frame_ancestors.
CC_FRAME_ANCESTORS='none'

# Site origins the pane may post hcw-addon messages to, space-separated (served by /api/health as siteOrigins).
CC_SITE_ORIGINS=

# Human-verification secret (vault key vault_addon_cloud_crawler_turnstile_secret). Never commit a value.
TURNSTILE_SECRET=

# Human-verification public site key, published by /api/health.
CC_TURNSTILE_SITE_KEY=

# Local development only: allow uploads without human verification (logged as a warning at startup).
CC_ALLOW_NO_TURNSTILE=0

# Session lifetime and store capacity.
CC_TTL_MINUTES=120
CC_MAX_ITEMS=200

# Rate limit on uploads per client address, and the concurrency bound on evaluation.
CC_RATE_LIMIT_POSTS=10
CC_RATE_LIMIT_WINDOW_MINUTES=10
CC_MAX_CONCURRENT=2

# 1 when the first X-Forwarded-For value is the client address (only behind the lab host's reverse proxy).
CC_TRUST_PROXY=0

# 1 silences the JSON log lines on stderr (tests).
CC_LOG_SILENT=0

# Override the static pane directory (default: web/ beside the package).
CC_STATIC_DIR=

# Override the directory of fictional sample files the lab serves at /api/samples (default: samples/ beside the package;
# the image sets /app/samples).
CC_SAMPLES_DIR=

# Everything held for visitors at once, in megabytes. Results are in memory only; when a new one would not fit, the
# oldest go first. The count limit is CC_MAX_ITEMS above.
CC_MAX_STORE_MB=64
